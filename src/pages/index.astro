---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Home/Hero.astro";
import ProductsSection from "../components/Home/ProductsSection.astro";
---

<Layout
  title="Home"
  description="Unsigned Labs - Building tools for digital self-sovereignty through cryptography, FOSS & open protocols"
>
  <Hero />
  <div class="section light">
    <ProductsSection />
  </div>
</Layout>

<style>
  .section::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(123, 104, 238, .5), transparent);
  }
</style>
